# Copie para .env (ou informe no Portainer, em "Environment variables" da stack).
# Linhas marcadas como OBRIGATÓRIA precisam ser preenchidas.

# --- Aplicação ---
APP_VERSION=1.0.0-rc.1
APP_PORT=8000
# OBRIGATÓRIA: chave longa e aleatória. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Nomes/IPs pelos quais o sistema será acessado, separados por vírgula
ALLOWED_HOSTS=patrimonio.intranet.local,10.0.0.10
# Origens com esquema, necessárias quando acessado por HTTPS ou porta diferente de 80/443
CSRF_TRUSTED_ORIGINS=https://patrimonio.intranet.local
# true quando houver proxy reverso com HTTPS na frente (cookies seguros, X-Forwarded-Proto)
USE_HTTPS=true
# Com USE_HTTPS=true: redireciona HTTP para HTTPS (true/false) e ativa HSTS (segundos; 0 = desligado)
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# --- HTTPS (serviço proxy) ---
# Nomes/IPs de acesso em HTTPS, separados por vírgula (os mesmos do ALLOWED_HOSTS)
SITE_ADDRESS=patrimonio.intranet.local, 10.0.0.10
# internal = certificado gerado pelo próprio sistema (instale o certificado raiz nos aparelhos:
# http://<servidor>/certificado-ca.crt). Com o certificado do órgão:
#   CERTS_PATH=/caminho/absoluto/da/pasta/com/cert.pem/e/key.pem
#   TLS_CERT=/certs/cert.pem /certs/key.pem
TLS_CERT=internal

HTTP_PORT=80
HTTPS_PORT=443
# 127.0.0.1 fecha o acesso direto pela porta 8000 (só o proxy alcança o app)
APP_BIND=127.0.0.1
TIME_ZONE=America/Sao_Paulo
ORG_NAME=Prefeitura Municipal de Duque de Caxias
ORG_UNIT_NAME=Subsecretaria de Tecnologia da Informação e Modernização Administrativa
# Cidade na data por extenso dos termos
DOC_CITY=Duque de Caxias
SESSION_TIMEOUT_MINUTES=480
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# --- Banco de dados ---
DB_NAME=patrimonio
DB_USER=patrimonio
# OBRIGATÓRIA
DB_PASSWORD=

# --- Administrador inicial (usado só quando o banco ainda não tem usuários) ---
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_NAME=Administrador do Sistema

# --- Backup ---
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30
# Caminho no servidor (fora do disco do sistema, de preferência um compartilhamento de rede).
# Vazio = volume Docker "backups". O diretório precisa pertencer ao UID 1000.
BACKUP_PATH=
